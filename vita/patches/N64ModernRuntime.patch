+//---------------------------------------------------------
+// Semaphore (PS Vita kernel)
+//---------------------------------------------------------
+// The VitaSDK POSIX semaphores (pthread-embedded) keep their own counter on top of a kernel semaphore and
+// poll it every 500 us. In TEST 6 the counts drifted ahead of the real signals: the gfx thread's queue
+// semaphore reported items the queue did not have, and N64 threads woke without being resumed. The kernel's
+// own counting semaphore is used directly instead.
+
+// Vita diagnostics, read by the port's stats log: failures of the kernel semaphore calls and their error codes.
+struct VitaSemaStats {
+	std::atomic<std::uint32_t> init_failures{0};
+	std::atomic<int> init_last_error{0};
+	std::atomic<std::uint32_t> wait_failures{0};      // sceKernelWaitSema failed (not a timeout)
+	std::atomic<int> wait_last_error{0};
+	std::atomic<std::uint32_t> post_failures{0};      // sceKernelSignalSema failed
+	std::atomic<int> post_last_error{0};
+	std::atomic<std::uint32_t> created{0};
+};
+inline VitaSemaStats vita_sema_stats;
+
+class Semaphore
+{
+private:
+	SceUID m_sema;
+
+	Semaphore(const Semaphore& other) MOODYCAMEL_DELETE_FUNCTION;
+	Semaphore& operator=(const Semaphore& other) MOODYCAMEL_DELETE_FUNCTION;
+
+	void record_wait_failure(int rc)
+	{
+		vita_sema_stats.wait_last_error = rc;
+		vita_sema_stats.wait_failures++;
+	}
+
+public:
+	Semaphore(int initialCount = 0)
+	{
+		assert(initialCount >= 0);
+		m_sema = sceKernelCreateSema("moodycamel", SCE_KERNEL_ATTR_THREAD_PRIO, initialCount, 0x7FFFFFFF, nullptr);
+		if (m_sema < 0) {
+			vita_sema_stats.init_last_error = m_sema;
+			vita_sema_stats.init_failures++;
+		}
+		else {
+			vita_sema_stats.created++;
+		}
+	}
+
+	~Semaphore()
+	{
+		if (m_sema >= 0) {
+			sceKernelDeleteSema(m_sema);
+		}
+	}
+
+	bool wait()
+	{
+		int rc = sceKernelWaitSema(m_sema, 1, nullptr);
+		if (rc < 0) {
+			record_wait_failure(rc);
+		}
+		return rc >= 0;
+	}
+
+	bool try_wait()
+	{
+		return sceKernelPollSema(m_sema, 1) >= 0;
+	}
+
+	bool timed_wait(std::uint64_t usecs)
+	{
+		SceUInt timeout = usecs > 0xFFFFFFFFull ? 0xFFFFFFFFu : static_cast<SceUInt>(usecs);
+		int rc = sceKernelWaitSema(m_sema, 1, &timeout);
+		if (rc < 0 && rc != (int)SCE_KERNEL_ERROR_WAIT_TIMEOUT) {
+			record_wait_failure(rc);
+		}
+		return rc >= 0;
+	}
+
+	void signal()
+	{
+		int rc = sceKernelSignalSema(m_sema, 1);
+		if (rc < 0) {
+			vita_sema_stats.post_last_error = rc;
+			vita_sema_stats.post_failures++;
+		}
+	}
+
+	void signal(int count)
+	{
+		if (count > 0) {
+			int rc = sceKernelSignalSema(m_sema, count);
+			if (rc < 0) {
+				vita_sema_stats.post_last_error = rc;
+				vita_sema_stats.post_failures++;
+			}
+		}
+	}
+};
 #elif defined(__unix__)
 //---------------------------------------------------------
 // Semaphore (POSIX, Linux)
