diff --git a/librecomp/include/librecomp/addresses.hpp b/librecomp/include/librecomp/addresses.hpp
index b1b50cb..e1be212 100644
--- a/librecomp/include/librecomp/addresses.hpp
+++ b/librecomp/include/librecomp/addresses.hpp
@@ -6,10 +6,17 @@
 #include "recomp.h"
 
 namespace recomp {
+#if defined(__vita__)
+    // PS Vita: 32 MiB covers the game's RDRAM (8 MiB), the runtime and patch data at 0x80800000,
+    // and leaves 16 MiB for the heap above mod_rdram_start. A 32-bit process cannot reserve 4GB.
+    constexpr size_t mem_size = 32ULL * 1024ULL * 1024ULL;
+    constexpr size_t allocation_size = mem_size;
+#else
     // 512GB (kseg0 size)
     constexpr size_t mem_size = 512ULL * 1024ULL * 1024ULL;
     // 4GB (the full address space)
     constexpr size_t allocation_size = 4096ULL * 1024ULL * 1024ULL;
+#endif
     // We need a place in rdram to hold the PI handles, so pick an address in extended rdram
     constexpr int32_t cart_handle = 0x80800000;
     constexpr int32_t drive_handle = (int32_t)(cart_handle + sizeof(OSPiHandle));
diff --git a/librecomp/include/librecomp/mods.hpp b/librecomp/include/librecomp/mods.hpp
index 37556bd..097ef58 100644
--- a/librecomp/include/librecomp/mods.hpp
+++ b/librecomp/include/librecomp/mods.hpp
@@ -50,12 +50,17 @@ template <>
 struct std::hash<recomp::mods::HookDefinition>
 {
     std::size_t operator()(const recomp::mods::HookDefinition& def) const {
-        // This hash packing only works if the resulting value is 64 bits.
-        static_assert(sizeof(std::size_t) == 8);
         // Combine the three values into a single 64-bit value.
         // The lower 2 bits of a function address will always be zero, so pack
         // the value of at_return into the lowest bit.
-        return (size_t(def.section_rom) << 32) | size_t(def.function_vram) | size_t(def.at_return ? 1 : 0);
+        const uint64_t packed = (uint64_t(def.section_rom) << 32) | uint64_t(def.function_vram) | uint64_t(def.at_return ? 1 : 0);
+        if constexpr (sizeof(std::size_t) == 8) {
+            return std::size_t(packed);
+        }
+        else {
+            // On 32-bit targets (PS Vita) size_t cannot hold the packed value, so hash it instead.
+            return std::hash<uint64_t>{}(packed);
+        }
     }
 };
 
